# ── Database (Neon) ──────────────────────────────────────────────────────────
# Pooled connection — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (unpooled) connection — used by prisma migrate
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── Auth.js ──────────────────────────────────────────────────────────────────
AUTH_SECRET="run: npx auth secret"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Comma-separated GitHub logins allowed to sign in. Empty = allow the first user only.
AUTH_ALLOWED_LOGINS="jiramaru"

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
GROQ_API_KEY=""
PERPLEXITY_API_KEY=""

# ── Macro / news data ────────────────────────────────────────────────────────
FRED_API_KEY=""
FINNHUB_API_KEY=""
MARKETAUX_API_KEY=""
NEWS_API_KEY=""
FXMACRODATA_API_KEY=""

# ── MetaTrader (MetaApi.cloud) ───────────────────────────────────────────────
METAAPI_TOKEN=""
METAAPI_ACCOUNT_ID=""

# ── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret so the daily sync endpoint is not world-callable
CRON_SECRET="any long random string"
